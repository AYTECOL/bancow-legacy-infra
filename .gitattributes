# BANCOW Infrastructure Repository - Git Attributes

# Auto detect text files and normalize line endings to LF
* text=auto eol=lf

# CloudFormation/SAM templates
*.yaml text eol=lf
*.yml text eol=lf

# JSON files
*.json text eol=lf

# Markdown documentation
*.md text eol=lf

# Shell scripts
*.sh text eol=lf
*.bash text eol=lf

# PowerShell scripts
*.ps1 text eol=crlf
*.psm1 text eol=crlf

# GitHub workflows
.github/workflows/*.yml text eol=lf
.github/workflows/*.yaml text eol=lf

# Binary files
*.zip binary
*.tar binary
*.gz binary
*.jar binary
*.war binary
*.ear binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary

# Exclude from exports
.gitattributes export-ignore
.gitignore export-ignore
.github/ export-ignore
