{
  "Comment": "BANCOW - Natural Person Orchestration",
  "StartAt": "InitInput",
  "States": {
    "InitInput": {
      "Type": "Choice",
      "Choices": [
        {
          "Variable": "$",
          "IsString": true,
          "Next": "ParseStringInput"
        }
      ],
      "Default": "WrapObjectInput"
    },

    "ParseStringInput": {
      "Type": "Pass",
      "Parameters": {
        "request.$": "States.StringToJson($)"
      },
      "Next": "ValidateMinimalInput"
    },

    "WrapObjectInput": {
      "Type": "Pass",
      "Parameters": {
        "request.$": "$"
      },
      "Next": "ValidateMinimalInput"
    },

    "ValidateMinimalInput": {
      "Type": "Choice",
      "Choices": [
        {
          "Variable": "$.request.numeroIdentificacion",
          "IsPresent": true,
          "Next": "ValidatePais"
        }
      ],
      "Default": "ValidationFailed"
    },

    "ValidatePais": {
      "Type": "Choice",
      "Choices": [
        {
          "Variable": "$.request.pais",
          "IsPresent": true,
          "Next": "ValidateTipoIdentificacion"
        }
      ],
      "Default": "ValidationFailed"
    },

    "ValidateTipoIdentificacion": {
      "Type": "Choice",
      "Choices": [
        {
          "Variable": "$.request.tipoIdentificacion",
          "IsPresent": true,
          "Next": "ValidateConsultarDomicilios"
        }
      ],
      "Default": "ValidationFailed"
    },

    "ValidateConsultarDomicilios": {
      "Type": "Choice",
      "Choices": [
        {
          "Variable": "$.request.consultarDomiciliosPersonas",
          "IsPresent": true,
          "Next": "DecideDomicilios"
        }
      ],
      "Default": "ValidationFailed"
    },

    "DecideDomicilios": {
      "Type": "Choice",
      "Choices": [
        {
          "Variable": "$.request.consultarDomiciliosPersonas",
          "BooleanEquals": true,
          "Next": "ParallelPersonaDomicilios"
        }
      ],
      "Default": "OnlyPerson"
    },

    "ParallelPersonaDomicilios": {
      "Type": "Parallel",
      "ResultPath": "$.parallel",
      "Branches": [
        {
          "StartAt": "GetPhysicalPerson",
          "States": {
            "GetPhysicalPerson": {
              "Type": "Task",
              "Resource": "arn:aws:states:::lambda:invoke",
              "Parameters": {
                "FunctionName": "${GetPersonFn}",
                "Payload.$": "$.request"
              },
              "ResultSelector": {
                "persona.$": "$.Payload"
              },
              "Retry": [
                {
                  "ErrorEquals": ["States.TaskFailed"],
                  "IntervalSeconds": 2,
                  "MaxAttempts": 3,
                  "BackoffRate": 2
                }
              ],
              "Catch": [
                {
                  "ErrorEquals": ["States.ALL"],
                  "Next": "PhysicalPersonFailed"
                }
              ],
              "End": true
            },
            "PhysicalPersonFailed": {
              "Type": "Fail",
              "Error": "PhysicalPersonError",
              "Cause": "Failed to retrieve physical person data"
            }
          }
        },
        {
          "StartAt": "GetAddresses",
          "States": {
            "GetAddresses": {
              "Type": "Task",
              "Resource": "arn:aws:states:::lambda:invoke",
              "Parameters": {
                "FunctionName": "${GetAddressesFn}",
                "Payload.$": "$.request"
              },
              "ResultSelector": {
                "domiciliosPersonasResponse": {
                  "domicilioPersona.$": "$.Payload.listDomicilios.domicilio"
                }
              },
              "Retry": [
                {
                  "ErrorEquals": ["States.TaskFailed"],
                  "IntervalSeconds": 2,
                  "MaxAttempts": 3,
                  "BackoffRate": 2
                }
              ],
              "Catch": [
                {
                  "ErrorEquals": ["States.ALL"],
                  "Next": "AddressesFailed"
                }
              ],
              "End": true
            },
            "AddressesFailed": {
              "Type": "Fail",
              "Error": "AddressesError",
              "Cause": "Failed to retrieve addresses data"
            }
          }
        }
      ],
      "Next": "MergeParallelResults"
    },

    "MergeParallelResults": {
      "Type": "Pass",
      "Parameters": {
        "domiciliosPersonasResponse.$": "$.parallel[1].domiciliosPersonasResponse",
        "personaFisicaResponse.$": "$.parallel[0].persona"
      },
      "Next": "HttpResponse"
    },

    "OnlyPerson": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "${GetPersonFn}",
        "Payload.$": "$.request"
      },
      "ResultSelector": {
        "personaFisicaResponse.$": "$.Payload"
      },
      "ResultPath": "$.result",
      "Retry": [
        {
          "ErrorEquals": ["States.TaskFailed"],
          "IntervalSeconds": 2,
          "MaxAttempts": 3,
          "BackoffRate": 2
        }
      ],
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "Next": "ProcessingFailed"
        }
      ],
      "Next": "PrepareSingleResult"
    },

    "PrepareSingleResult": {
      "Type": "Pass",
      "Parameters": {
        "domiciliosPersonasResponse": {
          "domicilioPersona": []
        },
        "personaFisicaResponse.$": "$.result.personaFisicaResponse"
      },
      "Next": "HttpResponse"
    },

    "HttpResponse": {
      "Type": "Pass",
      "Parameters": {
        "domiciliosPersonasResponse.$": "$.domiciliosPersonasResponse",
        "personaFisicaResponse.$": "$.personaFisicaResponse"
      },
      "End": true
    },

    "ValidationFailed": {
      "Type": "Fail",
      "Error": "ValidationError",
      "Cause": "Missing required input fields"
    },

    "ProcessingFailed": {
      "Type": "Fail",
      "Error": "ProcessingError",
      "Cause": "Unexpected error during processing"
    }
  }
}
