{
  "Comment": "BANCOW - Natural Person Orchestration",
  "StartAt": "InitInput",
  "States": {
    "InitInput": {
      "Type": "Choice",
      "Choices": [
        {
          "Variable": "$",
          "IsString": true,
          "Next": "ParseStringInput"
        }
      ],
      "Default": "WrapObjectInput"
    },

    "ParseStringInput": {
      "Type": "Pass",
      "Parameters": {
        "request.$": "States.StringToJson($)"
      },
      "Next": "ValidateMinimalInput"
    },

    "WrapObjectInput": {
      "Type": "Pass",
      "Parameters": {
        "request.$": "$"
      },
      "Next": "ValidateMinimalInput"
    },

    "ValidateMinimalInput": {
      "Type": "Choice",
      "Choices": [
        {
          "Variable": "$.request.numeroIdentificacion",
          "IsPresent": true,
          "Next": "ValidatePais"
        }
      ],
      "Default": "ValidationFailed"
    },

    "ValidatePais": {
      "Type": "Choice",
      "Choices": [
        {
          "Variable": "$.request.pais",
          "IsPresent": true,
          "Next": "ValidateTipoIdentificacion"
        }
      ],
      "Default": "ValidationFailed"
    },

    "ValidateTipoIdentificacion": {
      "Type": "Choice",
      "Choices": [
        {
          "Variable": "$.request.tipoIdentificacion",
          "IsPresent": true,
          "Next": "ValidateConsultarDomicilios"
        }
      ],
      "Default": "ValidationFailed"
    },

    "ValidateConsultarDomicilios": {
      "Type": "Choice",
      "Choices": [
        {
          "Variable": "$.request.consultarDomiciliosPersonas",
          "IsPresent": true,
          "Next": "ValidateExecutionMode"
        }
      ],
      "Default": "ValidationFailed"
    },

    "ValidateExecutionMode": {
      "Type": "Choice",
      "Choices": [
        {
          "Variable": "$.request.executionMode",
          "StringEquals": "HTTP",
          "Next": "DecideDomiciliosHttp"
        }
      ],
      "Default": "DecideDomiciliosLambda"
    },

    "DecideDomiciliosLambda": {
      "Type": "Choice",
      "Choices": [
        {
          "Variable": "$.request.consultarDomiciliosPersonas",
          "BooleanEquals": true,
          "Next": "ParallelPersonaDomicilios"
        }
      ],
      "Default": "OnlyPerson"
    },

    "ParallelPersonaDomicilios": {
      "Type": "Parallel",
      "ResultPath": "$.parallel",
      "Branches": [
        {
          "StartAt": "GetPhysicalPerson",
          "States": {
            "GetPhysicalPerson": {
              "Type": "Task",
              "Resource": "arn:aws:states:::lambda:invoke",
              "Parameters": {
                "FunctionName": "${GetPersonFn}",
                "Payload.$": "$.request"
              },
              "ResultSelector": {
                "persona.$": "$.Payload"
              },
              "End": true
            }
          }
        },
        {
          "StartAt": "GetAddresses",
          "States": {
            "GetAddresses": {
              "Type": "Task",
              "Resource": "arn:aws:states:::lambda:invoke",
              "Parameters": {
                "FunctionName": "${GetAddressesFn}",
                "Payload.$": "$.request"
              },
              "ResultSelector": {
                "domiciliosPersonasResponse": {
                  "domicilioPersona.$": "$.Payload.listDomicilios.domicilio"
                }
              },
              "End": true
            }
          }
        }
      ],
      "Next": "MergeParallelResults"
    },

    "DecideDomiciliosHttp": {
      "Type": "Choice",
      "Choices": [
        {
          "Variable": "$.request.consultarDomiciliosPersonas",
          "BooleanEquals": true,
          "Next": "ParallelHttpPersonaDomicilios"
        }
      ],
      "Default": "OnlyPersonHttp"
    },

    "ParallelHttpPersonaDomicilios": {
      "Type": "Parallel",
      "ResultPath": "$.parallel",
      "Branches": [
        {
          "StartAt": "HttpGetPhysicalPerson",
          "States": {
            "HttpGetPhysicalPerson": {
              "Type": "Task",
              "Resource": "arn:aws:states:::http:invoke",
              "Parameters": {
                "Method": "POST",
                "ApiEndpoint": "https://yv4bh5uymk.execute-api.us-east-1.amazonaws.com/dev/person/physical",
                "Authentication": {
                  "ConnectionArn": "arn:aws:events:us-east-1:334333507387:connection/bancow-apigw-connection/b8969188-f094-4069-a04b-6689bcbf6495"
                },
                "RequestBody": {
                  "executionMode.$": "$.request.executionMode",
                  "numeroIdentificacion.$": "$.request.numeroIdentificacion",
                  "tipoIdentificacion.$": "$.request.tipoIdentificacion",
                  "pais.$": "$.request.pais",
                  "parametrosAdicionales.$": "$.request.parametrosAdicionales"
                }
              },
              "ResultSelector": {
                "persona.$": "$.ResponseBody"
              },
              "End": true
            }
          }
        },
        {
          "StartAt": "HttpGetAddresses",
          "States": {
            "HttpGetAddresses": {
              "Type": "Task",
              "Resource": "arn:aws:states:::http:invoke",
              "Parameters": {
                "Method": "POST",
                "ApiEndpoint": "https://yv4bh5uymk.execute-api.us-east-1.amazonaws.com/dev/person/addresses",
                "Authentication": {
                  "ConnectionArn": "arn:aws:events:us-east-1:334333507387:connection/bancow-apigw-connection/b8969188-f094-4069-a04b-6689bcbf6495"
                },
                "RequestBody": {
                  "executionMode.$": "$.request.executionMode",
                  "numeroIdentificacion.$": "$.request.numeroIdentificacion",
                  "pais.$": "$.request.pais",
                  "tipoIdentificacion.$": "$.request.tipoIdentificacion"
                }
              },
              "ResultSelector": {
                "domiciliosPersonasResponse.$": "$.ResponseBody"
              },
              "End": true
            }
          }
        }
      ],
      "Next": "MergeParallelResults"
    },

    "MergeParallelResults": {
      "Type": "Pass",
      "Parameters": {
        "domiciliosPersonasResponse.$": "$.parallel[1].domiciliosPersonasResponse",
        "personaFisicaResponse.$": "$.parallel[0].persona"
      },
      "Next": "HttpResponse"
    },

    "OnlyPerson": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "${GetPersonFn}",
        "Payload.$": "$.request"
      },
      "ResultSelector": {
        "personaFisicaResponse.$": "$.Payload"
      },
      "Next": "HttpResponse"
    },

    "OnlyPersonHttp": {
      "Type": "Task",
      "Resource": "arn:aws:states:::http:invoke",
      "Parameters": {
        "Method": "POST",
        "ApiEndpoint": "https://yv4bh5uymk.execute-api.us-east-1.amazonaws.com/dev/person/physical",
        "Authentication": {
          "ConnectionArn": "arn:aws:events:us-east-1:334333507387:connection/bancow-apigw-connection/b8969188-f094-4069-a04b-6689bcbf6495"
        },
        "RequestBody": {
          "executionMode.$": "$.request.executionMode",
          "numeroIdentificacion.$": "$.request.numeroIdentificacion",
          "tipoIdentificacion.$": "$.request.tipoIdentificacion",
          "pais.$": "$.request.pais",
          "parametrosAdicionales.$": "$.request.parametrosAdicionales"
        }
      },
      "ResultSelector": {
        "personaFisicaResponse.$": "$.ResponseBody"
      },
      "Next": "HttpResponse"
    },

    "HttpResponse": {
      "Type": "Pass",
      "Parameters": {
        "domiciliosPersonasResponse.$": "$.domiciliosPersonasResponse",
        "personaFisicaResponse.$": "$.personaFisicaResponse"
      },
      "End": true
    },

    "ValidationFailed": {
      "Type": "Fail",
      "Error": "ValidationError",
      "Cause": "Missing required input fields"
    }
  }
}
