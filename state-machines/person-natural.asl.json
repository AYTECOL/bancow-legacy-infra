{
  "Comment": "v2 - Orquestación persona natural optimizada",
  "StartAt": "ValidarInput",
  "States": {
    "ValidarInput": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "${ValidateFn}",
        "Payload.$": "$"
      },
      "ResultSelector": {
        "Payload.$": "$.Payload"
      },
      "ResultPath": "$",
      "Next": "ParaleloPersonaYDomicilios",
      "TimeoutSeconds": 5,
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "ResultPath": "$.error",
          "Next": "ValidationFailed"
        }
      ]
    },
    "ParaleloPersonaYDomicilios": {
      "Type": "Parallel",
      "Branches": [
        {
          "StartAt": "GetPersona",
          "States": {
            "GetPersona": {
              "Type": "Task",
              "Resource": "arn:aws:states:::lambda:invoke",
              "Parameters": {
                "FunctionName": "${GetPersonFn}",
                "Payload.$": "$.Payload"
              },
              "ResultSelector": { "data.$": "$.Payload.data" },
              "ResultPath": "$.persona",
              "End": true
            }
          }
        },
        {
          "StartAt": "GetDomicilios",
          "States": {
            "GetDomicilios": {
              "Type": "Task",
              "Resource": "arn:aws:states:::lambda:invoke",
              "Parameters": {
                "FunctionName": "${GetAddressesFn}",
                "Payload.$": "$.Payload"
              },
              "ResultSelector": { "data.$": "$.Payload.data" },
              "ResultPath": "$.domicilios",
              "End": true
            }
          }
        }
      ],
      "ResultPath": "$.enriquecido",
      "Next": "Normalizar",
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "ResultPath": "$.error",
          "Next": "ProcessingFailed"
        }
      ]
    },
    "Normalizar": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "${NormalizeFn}",
        "Payload": {
          "enriquecido.$": "$.enriquecido",
          "correlationId.$": "$.Payload.validatedData.numeroIdentificacion"
        }
      },
      "ResultSelector": { "Payload.$": "$.Payload" },
      "OutputPath": "$.Payload",
      "Next": "SuccessState",
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "ResultPath": "$.error",
          "Next": "NormalizationFailed"
        }
      ]
    },
    "SuccessState": {
      "Type": "Pass",
      "End": true
    },
    "ValidationFailed": {
      "Type": "Pass",
      "Result": {
        "statusCode": 400,
        "body": "{\"error\": \"Validation failed\"}"
      },
      "End": true
    },
    "ProcessingFailed": {
      "Type": "Pass",
      "Parameters": {
        "statusCode": 500,
        "body.$": "States.JsonToString($.error)"
      },
      "End": true
    },
    "NormalizationFailed": {
      "Type": "Pass",
      "Result": {
        "statusCode": 500,
        "body": "{\"error\": \"Normalization Error\"}"
      },
      "End": true
    }
  }
}