{
  "Comment": "v2 - Orquestación persona natural (persona física + domicilios)",
  "StartAt": "ValidarInput",
  "States": {
    "ValidarInput": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "${ValidateFn}",
        "Payload.$": "$"
      },
      "ResultPath": "$",
      "Next": "ParaleloPersonaYDomicilios",
      "TimeoutSeconds": 5,
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "ResultPath": "$.error",
          "Next": "ValidationFailed"
        }
      ]
    },
    "ParaleloPersonaYDomicilios": {
      "Type": "Parallel",
      "Branches": [
        {
          "StartAt": "GetPersona",
          "States": {
            "GetPersona": {
              "Type": "Task",
              "Resource": "arn:aws:states:::lambda:invoke",
              "Parameters": {
                "FunctionName": "${GetPersonFn}",
                "Payload.$": "$"
              },
              "ResultPath": "$.persona",
              "End": true,
              "Retry": [
                {
                  "ErrorEquals": [
                    "States.Timeout",
                    "Lambda.TooManyRequestsException"
                  ],
                  "IntervalSeconds": 1,
                  "MaxAttempts": 1,
                  "BackoffRate": 2
                }
              ],
              "TimeoutSeconds": 12
            }
          }
        },
        {
          "StartAt": "GetDomicilios",
          "States": {
            "GetDomicilios": {
              "Type": "Task",
              "Resource": "arn:aws:states:::lambda:invoke",
              "Parameters": {
                "FunctionName": "${GetAddressesFn}",
                "Payload.$": "$"
              },
              "ResultPath": "$.domicilios",
              "End": true,
              "Retry": [
                {
                  "ErrorEquals": [
                    "States.Timeout",
                    "Lambda.TooManyRequestsException"
                  ],
                  "IntervalSeconds": 1,
                  "MaxAttempts": 1,
                  "BackoffRate": 2
                }
              ],
              "TimeoutSeconds": 12
            }
          }
        }
      ],
      "ResultPath": "$.enriquecido",
      "Next": "Normalizar",
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "ResultPath": "$.error",
          "Next": "ProcessingFailed"
        }
      ]
    },
    "Normalizar": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "${NormalizeFn}",
        "Payload.$": "$"
      },
      "ResultPath": "$",
      "Next": "SuccessState",
      "TimeoutSeconds": 10,
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "ResultPath": "$.error",
          "Next": "NormalizationFailed"
        }
      ]
    },
    "SuccessState": {
      "Type": "Pass",
      "End": true
    },
    "ValidationFailed": {
      "Type": "Pass",
      "Result": {
        "statusCode": 400,
        "body": "{\"error\": \"Validation failed\"}"
      },
      "End": true
    },
    "ProcessingFailed": {
      "Type": "Pass",
      "Result": {
        "statusCode": 500,
        "body.$": "States.JsonToString($.error)"
      },
      "End": true
    },
    "NormalizationFailed": {
      "Type": "Pass",
      "Result": {
        "statusCode": 500,
        "body": "{\"error\": \"Normalization Error\"}"
      },
      "End": true
    }
  }
}