{
  "Comment": "BANCOW - Natural Person Orchestration",
  "StartAt": "Init",
  "States": {
    "Init": {
      "Type": "Pass",
      "ResultPath": "$.request",
      "Next": "ValidateMinimalInput"
    },
    "ValidateMinimalInput": {
      "Type": "Choice",
      "Choices": [
        {
          "Variable": "$.request.numeroIdentificacion",
          "IsPresent": true,
          "Next": "ValidatePais"
        }
      ],
      "Default": "ValidationFailed"
    },
    "ValidatePais": {
      "Type": "Choice",
      "Choices": [
        {
          "Variable": "$.request.pais",
          "IsPresent": true,
          "Next": "DecideDomicilios"
        }
      ],
      "Default": "ValidationFailed"
    },
    "DecideDomicilios": {
      "Type": "Choice",
      "Choices": [
        {
          "Variable": "$.request.consultarDomiciliosPersonas",
          "BooleanEquals": true,
          "Next": "ParallelPersonaDomicilios"
        }
      ],
      "Default": "OnlyPersona"
    },
    "ParallelPersonaDomicilios": {
      "Type": "Parallel",
      "ResultPath": "$.parallel",
      "Branches": [
        {
          "StartAt": "GetPhysicalPerson",
          "States": {
            "GetPhysicalPerson": {
              "Type": "Task",
              "Resource": "arn:aws:states:::lambda:invoke",
              "Parameters": {
                "FunctionName": "${GetPersonFn}",
                "Payload.$": "$.request"
              },
              "ResultSelector": {
                "persona.$": "$.Payload"
              },
              "Retry": [
                {
                  "ErrorEquals": ["States.TaskFailed"],
                  "IntervalSeconds": 2,
                  "MaxAttempts": 3,
                  "BackoffRate": 2
                }
              ],
              "Catch": [
                {
                  "ErrorEquals": ["States.ALL"],
                  "ResultPath": "$.error",
                  "Next": "PhysicalPersonFailed"
                }
              ],
              "End": true
            },
            "PhysicalPersonFailed": {
              "Type": "Fail",
              "Error": "PhysicalPersonError",
              "Cause": "Failed to retrieve physical person data"
            }
          }
        },
        {
          "StartAt": "GetAddresses",
          "States": {
            "GetAddresses": {
              "Type": "Task",
              "Resource": "arn:aws:states:::lambda:invoke",
              "Parameters": {
                "FunctionName": "${GetAddressesFn}",
                "Payload.$": "$.request"
              },
              "ResultSelector": {
                "domicilios.$": "$.Payload"
              },
              "Retry": [
                {
                  "ErrorEquals": ["States.TaskFailed"],
                  "IntervalSeconds": 2,
                  "MaxAttempts": 3,
                  "BackoffRate": 2
                }
              ],
              "Catch": [
                {
                  "ErrorEquals": ["States.ALL"],
                  "ResultPath": "$.error",
                  "Next": "AddressesFailed"
                }
              ],
              "End": true
            },
            "AddressesFailed": {
              "Type": "Fail",
              "Error": "AddressesError",
              "Cause": "Failed to retrieve addresses data"
            }
          }
        }
      ],
      "Next": "MergeParallelResults",
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "ResultPath": "$.error",
          "Next": "ProcessingFailed"
        }
      ]
    },
    "MergeParallelResults": {
      "Type": "Pass",
      "Parameters": {
        "personaFisicaResponse.$": "$.parallel[0].persona",
        "domiciliosPersonasResponse.$": "$.parallel[1].domicilios",
        "informacionFatcaResponse": "",
        "informacionFinancieraResponse": "",
        "informacionVictimasHechosViolentosResponse": "",
        "referenciasPersonasResponse": ""
      },
      "Next": "Success"
    },
    "OnlyPerson": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "${GetPersonFn}",
        "Payload.$": "$.request"
      },
      "ResultSelector": {
        "persona.$": "$.Payload"
      },
      "ResultPath": "$.result",
      "Retry": [
        {
          "ErrorEquals": ["States.TaskFailed"],
          "IntervalSeconds": 2,
          "MaxAttempts": 3,
          "BackoffRate": 2
        }
      ],
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "ResultPath": "$.error",
          "Next": "ProcessingFailed"
        }
      ],
      "Next": "PrepareSingleResult"
    },
    "PrepareSingleResult": {
      "Type": "Pass",
      "Parameters": {
        "personaFisicaResponse.$": "$.result.persona",
        "domiciliosPersonasResponse": {
          "domicilioPersona": []
        },
        "informacionFatcaResponse": "",
        "informacionFinancieraResponse": "",
        "informacionVictimasHechosViolentosResponse": "",
        "referenciasPersonasResponse": ""
      },
      "Next": "Success"
    },
    "ValidationFailed": {
      "Type": "Fail",
      "Error": "ValidationError",
      "Cause": "Missing required input fields: numeroIdentificacion and pais are required"
    },
    "ProcessingFailed": {
      "Type": "Fail",
      "Error": "ProcessingError",
      "Cause": "Unexpected error during processing"
    },
    "Success": {
      "Type": "Succeed"
    }
  }
}