{
  "Comment": "BANCOW - Natural Person Orchestration",
  "StartAt": "InitInput",
  "States": {
    "InitInput": {
      "Type": "Choice",
      "Choices": [
        {
          "Variable": "$",
          "IsString": true,
          "Next": "ParseStringInput"
        }
      ],
      "Default": "WrapObjectInput"
    },

    "ParseStringInput": {
      "Type": "Pass",
      "Parameters": {
        "request.$": "States.StringToJson($)"
      },
      "Next": "ValidateMinimalInput"
    },

    "WrapObjectInput": {
      "Type": "Pass",
      "Parameters": {
        "request.$": "$"
      },
      "Next": "ValidateMinimalInput"
    },

    "InitOptionalOutputs": {
      "Type": "Pass",
      "Parameters": {
        "request.$": "$.request",
        "domiciliosPersonasResponse": ""
      },
      "Next": "ValidateExecutionMode"
    },

    "ValidateMinimalInput": {
      "Type": "Choice",
      "Choices": [
        {
          "Variable": "$.request.numeroIdentificacion",
          "IsPresent": true,
          "Next": "ValidatePais"
        }
      ],
      "Default": "ValidationFailed"
    },

    "ValidatePais": {
      "Type": "Choice",
      "Choices": [
        {
          "Variable": "$.request.pais",
          "IsPresent": true,
          "Next": "ValidateTipoIdentificacion"
        }
      ],
      "Default": "ValidationFailed"
    },

    "ValidateTipoIdentificacion": {
      "Type": "Choice",
      "Choices": [
        {
          "Variable": "$.request.tipoIdentificacion",
          "IsPresent": true,
          "Next": "ValidateConsultarDomicilios"
        }
      ],
      "Default": "ValidationFailed"
    },

    "ValidateConsultarDomicilios": {
      "Type": "Choice",
      "Choices": [
        {
          "Variable": "$.request.consultarDomiciliosPersonas",
          "IsPresent": true,
          "Next": "InitOptionalOutputs"
        }
      ],
      "Default": "ValidationFailed"
    },

    "ValidateExecutionMode": {
      "Type": "Choice",
      "Choices": [
        {
          "Variable": "$.request.executionMode",
          "StringEquals": "HTTP",
          "Next": "DecideDomiciliosHttp"
        }
      ],
      "Default": "DecideDomiciliosLambda"
    },

    "DecideDomiciliosLambda": {
      "Type": "Choice",
      "Choices": [
        {
          "Variable": "$.request.consultarDomiciliosPersonas",
          "BooleanEquals": true,
          "Next": "ParallelPersonaDomicilios"
        }
      ],
      "Default": "OnlyPerson"
    },

    "ParallelPersonaDomicilios": {
      "Type": "Parallel",
      "ResultPath": "$.parallel",
      "Branches": [
        {
          "StartAt": "GetPhysicalPerson",
          "States": {
            "GetPhysicalPerson": {
              "Type": "Task",
              "Resource": "arn:aws:states:::lambda:invoke",
              "Parameters": {
                "FunctionName": "${GetPersonFn}",
                "Payload.$": "$.request"
              },
              "ResultSelector": {
                "persona.$": "$.Payload"
              },
              "Retry": [
                {
                  "ErrorEquals": [
                    "Lambda.ServiceException",
                    "Lambda.TooManyRequestsException",
                    "States.Timeout"
                  ],
                  "IntervalSeconds": 2,
                  "MaxAttempts": 2,
                  "BackoffRate": 2.0
                }
              ],
              "Catch": [
                {
                  "ErrorEquals": [
                    "ValidationError",
                    "BusinessRuleError",
                    "DomainError"
                  ],
                  "ResultPath": "$.busError",
                  "Next": "HandleBusLambdaErrorPersona"
                }
              ],
              "End": true
            },
            "HandleBusLambdaErrorPersona": {
              "Type": "Pass",
              "Parameters": {
                "persona": {
                  "error": {
                    "source": "Lambda",
                    "errorType.$": "$.busError.Error",
                    "cause.$": "$.busError.Cause"
                  }
                }
              },
              "End": true
            }
          }
        },
        {
          "StartAt": "GetAddresses",
          "States": {
            "GetAddresses": {
              "Type": "Task",
              "Resource": "arn:aws:states:::lambda:invoke",
              "Parameters": {
                "FunctionName": "${GetAddressesFn}",
                "Payload.$": "$.request"
              },
              "ResultSelector": {
                "domiciliosPersonasResponse": {
                  "domicilioPersona.$": "$.Payload.listDomicilios.domicilio"
                }
              },
              "Retry": [
                {
                  "ErrorEquals": [
                    "Lambda.ServiceException",
                    "Lambda.TooManyRequestsException",
                    "States.Timeout"
                  ],
                  "IntervalSeconds": 2,
                  "MaxAttempts": 2,
                  "BackoffRate": 2.0
                }
              ],
              "Catch": [
                {
                  "ErrorEquals": [
                    "ValidationError",
                    "BusinessRuleError",
                    "DomainError"
                  ],
                  "ResultPath": "$.busError",
                  "Next": "HandleBusLambdaErrorAddresses"
                }
              ],
              "End": true
            },
            "HandleBusLambdaErrorAddresses": {
              "Type": "Pass",
              "Parameters": {
                "domiciliosPersonasResponse": {
                  "error": {
                    "source": "Lambda",
                    "errorType.$": "$.busError.Error",
                    "cause.$": "$.busError.Cause"
                  }
                }
              },
              "End": true
            }
          }
        }
      ],
      "Next": "MergeParallelResults"
    },

    "DecideDomiciliosHttp": {
      "Type": "Choice",
      "Choices": [
        {
          "Variable": "$.request.consultarDomiciliosPersonas",
          "BooleanEquals": true,
          "Next": "ParallelHttpPersonaDomicilios"
        }
      ],
      "Default": "OnlyPersonHttp"
    },

    "ParallelHttpPersonaDomicilios": {
      "Type": "Parallel",
      "ResultPath": "$.parallel",
      "Branches": [
        {
          "StartAt": "HttpGetPhysicalPerson",
          "States": {
            "HttpGetPhysicalPerson": {
              "Type": "Task",
              "Resource": "arn:aws:states:::http:invoke",
              "Parameters": {
                "Method": "POST",
                "ApiEndpoint": "https://yv4bh5uymk.execute-api.us-east-1.amazonaws.com/dev/person/physical",
                "Authentication": {
                  "ConnectionArn": "arn:aws:events:us-east-1:334333507387:connection/bancow-apigw-connection/b8969188-f094-4069-a04b-6689bcbf6495"
                },
                "RequestBody": {
                  "executionMode.$": "$.request.executionMode",
                  "numeroIdentificacion.$": "$.request.numeroIdentificacion",
                  "tipoIdentificacion.$": "$.request.tipoIdentificacion",
                  "pais.$": "$.request.pais",
                  "parametrosAdicionales.$": "$.request.parametrosAdicionales"
                }
              },
              "ResultSelector": {
                "persona.$": "$.ResponseBody"
              },
              "Retry": [
                {
                  "ErrorEquals": [
                    "States.Http.StatusCode.500",
                    "States.Http.StatusCode.502",
                    "States.Http.StatusCode.503",
                    "States.Http.StatusCode.504",
                    "States.Timeout"
                  ],
                  "IntervalSeconds": 2,
                  "MaxAttempts": 2,
                  "BackoffRate": 2.0
                }
              ],
              "Catch": [
                {
                  "ErrorEquals": [
                    "States.Http.StatusCode.400",
                    "States.Http.StatusCode.401",
                    "States.Http.StatusCode.403",
                    "States.Http.StatusCode.404",
                    "States.Http.StatusCode.422"
                  ],
                  "ResultPath": "$.busError",
                  "Next": "HandleBusHttpErrorPersona"
                }
              ],
              "End": true
            },
            "HandleBusHttpErrorPersona": {
              "Type": "Pass",
              "Parameters": {
                "persona": {
                  "error": {
                    "source": "HTTP",
                    "statusCode.$": "States.ArrayGetItem(States.StringSplit($.busError.Error, '.'), 4)",
                    "cause.$": "$.busError.Cause"
                  }
                }
              },
              "End": true
            }
          }
        },
        {
          "StartAt": "HttpGetAddresses",
          "States": {
            "HttpGetAddresses": {
              "Type": "Task",
              "Resource": "arn:aws:states:::http:invoke",
              "Parameters": {
                "Method": "POST",
                "ApiEndpoint": "https://yv4bh5uymk.execute-api.us-east-1.amazonaws.com/dev/person/addresses",
                "Authentication": {
                  "ConnectionArn": "arn:aws:events:us-east-1:334333507387:connection/bancow-apigw-connection/b8969188-f094-4069-a04b-6689bcbf6495"
                },
                "RequestBody": {
                  "executionMode.$": "$.request.executionMode",
                  "numeroIdentificacion.$": "$.request.numeroIdentificacion",
                  "pais.$": "$.request.pais",
                  "tipoIdentificacion.$": "$.request.tipoIdentificacion"
                }
              },
              "ResultSelector": {
                "domiciliosPersonasResponse.$": "$.ResponseBody"
              },
              "Retry": [
                {
                  "ErrorEquals": [
                    "States.Http.StatusCode.500",
                    "States.Http.StatusCode.502",
                    "States.Http.StatusCode.503",
                    "States.Http.StatusCode.504",
                    "States.Timeout"
                  ],
                  "IntervalSeconds": 2,
                  "MaxAttempts": 2,
                  "BackoffRate": 2.0
                }
              ],
              "Catch": [
                {
                  "ErrorEquals": [
                    "States.Http.StatusCode.400",
                    "States.Http.StatusCode.401",
                    "States.Http.StatusCode.403",
                    "States.Http.StatusCode.404",
                    "States.Http.StatusCode.422"
                  ],
                  "ResultPath": "$.busError",
                  "Next": "HandleBusHttpErrorAddresses"
                }
              ],
              "End": true
            },
            "HandleBusHttpErrorAddresses": {
              "Type": "Pass",
              "Parameters": {
                "domiciliosPersonasResponse": {
                  "error": {
                    "source": "HTTP",
                    "statusCode.$": "States.ArrayGetItem(States.StringSplit($.busError.Error, '.'), 4)",
                    "cause.$": "$.busError.Cause"
                  }
                }
              },
              "End": true
            }
          }
        }
      ],
      "Next": "MergeParallelResults"
    },

    "MergeParallelResults": {
      "Type": "Pass",
      "Parameters": {
        "domiciliosPersonasResponse.$": "$.parallel[1].domiciliosPersonasResponse",
        "personaFisicaResponse.$": "$.parallel[0].persona"
      },
      "Next": "HttpResponse"
    },

    "OnlyPerson": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "${GetPersonFn}",
        "Payload.$": "$.request"
      },
      "ResultPath": "$.personaFisicaResponse",
      "ResultSelector": {
        "personaFisicaResponse.$": "$.Payload"
      },
      "Retry": [
        {
          "ErrorEquals": [
            "Lambda.ServiceException",
            "Lambda.TooManyRequestsException",
            "States.Timeout"
          ],
          "IntervalSeconds": 2,
          "MaxAttempts": 2,
          "BackoffRate": 2.0
        }
      ],
      "Catch": [
        {
          "ErrorEquals": [
            "ValidationError",
            "BusinessRuleError",
            "DomainError"
          ],
          "ResultPath": "$.busError",
          "Next": "HandleBusLambdaErrorOnlyPerson"
        }
      ],
      "Next": "HttpResponse"
    },

    "HandleBusLambdaErrorOnlyPerson": {
      "Type": "Pass",
      "Parameters": {
        "domiciliosPersonasResponse.$": "$.domiciliosPersonasResponse",
        "personaFisicaResponse": {
          "error": {
            "source": "Lambda",
            "errorType.$": "$.busError.Error",
            "cause.$": "$.busError.Cause"
          }
        }
      },
      "Next": "HttpResponse"
    },

    "OnlyPersonHttp": {
      "Type": "Task",
      "Resource": "arn:aws:states:::http:invoke",
      "Parameters": {
        "Method": "POST",
        "ApiEndpoint": "https://yv4bh5uymk.execute-api.us-east-1.amazonaws.com/dev/person/physical",
        "Authentication": {
          "ConnectionArn": "arn:aws:events:us-east-1:334333507387:connection/bancow-apigw-connection/b8969188-f094-4069-a04b-6689bcbf6495"
        },
        "RequestBody": {
          "executionMode.$": "$.request.executionMode",
          "numeroIdentificacion.$": "$.request.numeroIdentificacion",
          "tipoIdentificacion.$": "$.request.tipoIdentificacion",
          "pais.$": "$.request.pais",
          "parametrosAdicionales.$": "$.request.parametrosAdicionales"
        }
      },
      "ResultPath": "$.personaFisicaResponse",
      "ResultSelector": {
        "personaFisicaResponse.$": "$.ResponseBody"
      },
      "Retry": [
        {
          "ErrorEquals": [
            "States.Http.StatusCode.500",
            "States.Http.StatusCode.502",
            "States.Http.StatusCode.503",
            "States.Http.StatusCode.504",
            "States.Timeout"
          ],
          "IntervalSeconds": 2,
          "MaxAttempts": 2,
          "BackoffRate": 2.0
        }
      ],
      "Catch": [
        {
          "ErrorEquals": [
            "States.Http.StatusCode.400",
            "States.Http.StatusCode.401",
            "States.Http.StatusCode.403",
            "States.Http.StatusCode.404",
            "States.Http.StatusCode.422"
          ],
          "ResultPath": "$.busError",
          "Next": "HandleBusHttpErrorOnlyPerson"
        }
      ],
      "Next": "HttpResponse"
    },

    "HandleBusHttpErrorOnlyPerson": {
      "Type": "Pass",
      "Parameters": {
        "domiciliosPersonasResponse.$": "$.domiciliosPersonasResponse",
        "personaFisicaResponse": {
          "error": {
            "source": "HTTP",
            "statusCode.$": "States.ArrayGetItem(States.StringSplit($.busError.Error, '.'), 4)",
            "cause.$": "$.busError.Cause"
          }
        }
      },
      "Next": "HttpResponse"
    },

    "HttpResponse": {
      "Type": "Pass",
      "Parameters": {
        "domiciliosPersonasResponse.$": "$.domiciliosPersonasResponse",
        "personaFisicaResponse.$": "$.personaFisicaResponse"
      },
      "End": true
    },

    "ValidationFailed": {
      "Type": "Fail",
      "Error": "ValidationError",
      "Cause": "Missing required input fields"
    }
  }
}
