{
  "Comment": "BANCOW - Natural Person Orchestration",
  "StartAt": "InitInput",
  "States": {
    "InitInput": {
      "Type": "Choice",
      "Choices": [
        { "Variable": "$", "IsString": true, "Next": "ParseStringInput" }
      ],
      "Default": "WrapObjectInput"
    },

    "ParseStringInput": {
      "Type": "Pass",
      "Parameters": { "request.$": "States.StringToJson($)" },
      "Next": "ValidateMinimalInput"
    },

    "WrapObjectInput": {
      "Type": "Pass",
      "Parameters": { "request.$": "$" },
      "Next": "ValidateMinimalInput"
    },

    "InitOptionalOutputs": {
      "Type": "Pass",
      "Parameters": {
        "request.$": "$.request",
        "domiciliosPersonasResponse": ""
      },
      "Next": "ValidateExecutionMode"
    },

    "ValidateMinimalInput": {
      "Type": "Choice",
      "Choices": [
        { "Variable": "$.request.numeroIdentificacion", "IsPresent": true, "Next": "ValidatePais" }
      ],
      "Default": "ValidationFailed"
    },

    "ValidatePais": {
      "Type": "Choice",
      "Choices": [
        { "Variable": "$.request.pais", "IsPresent": true, "Next": "ValidateTipoIdentificacion" }
      ],
      "Default": "ValidationFailed"
    },

    "ValidateTipoIdentificacion": {
      "Type": "Choice",
      "Choices": [
        { "Variable": "$.request.tipoIdentificacion", "IsPresent": true, "Next": "ValidateConsultarDomicilios" }
      ],
      "Default": "ValidationFailed"
    },

    "ValidateConsultarDomicilios": {
      "Type": "Choice",
      "Choices": [
        { "Variable": "$.request.consultarDomiciliosPersonas", "IsPresent": true, "Next": "InitOptionalOutputs" }
      ],
      "Default": "ValidationFailed"
    },

    "ValidateExecutionMode": {
      "Type": "Choice",
      "Choices": [
        { "Variable": "$.request.executionMode", "StringEquals": "HTTP", "Next": "DecideDomiciliosHttp" }
      ],
      "Default": "DecideDomiciliosLambda"
    },

    "DecideDomiciliosLambda": {
      "Type": "Choice",
      "Choices": [
        { "Variable": "$.request.consultarDomiciliosPersonas", "BooleanEquals": true, "Next": "ParallelPersonaDomicilios" }
      ],
      "Default": "OnlyPerson"
    },

    "ParallelPersonaDomicilios": {
      "Type": "Parallel",
      "ResultPath": "$.parallel",
      "Branches": [
        {
          "StartAt": "GetPhysicalPerson",
          "States": {
            "GetPhysicalPerson": {
              "Type": "Task",
              "Resource": "arn:aws:states:::lambda:invoke",
              "Parameters": {
                "FunctionName": "${GetPersonFn}",
                "Payload.$": "$.request"
              },
              "ResultSelector": { "persona.$": "$.Payload" },
              "Catch": [
                {
                  "ErrorEquals": ["ValidationError", "BusinessRuleError", "DomainError"],
                  "ResultPath": "$.busError",
                  "Next": "ParseLambdaErrorPersona"
                }
              ],
              "End": true
            },

            "ParseLambdaErrorPersona": {
              "Type": "Pass",
              "Parameters": {
                "parsedError.$": "States.StringToJson($.busError.Cause)"
              },
              "Next": "HandleLambdaErrorPersona"
            },

            "HandleLambdaErrorPersona": {
              "Type": "Pass",
              "Parameters": {
                "persona": {
                  "message.$": "$.parsedError.errorMessage",
                  "error": {
                    "type.$": "$.parsedError.errorType",
                    "message.$": "$.parsedError.errorMessage",
                    "metadata.$": "$.parsedError.metadata"
                  }
                }
              },
              "End": true
            }
          }
        },

        {
          "StartAt": "GetAddresses",
          "States": {
            "GetAddresses": {
              "Type": "Task",
              "Resource": "arn:aws:states:::lambda:invoke",
              "Parameters": {
                "FunctionName": "${GetAddressesFn}",
                "Payload.$": "$.request"
              },
              "ResultSelector": {
                "domiciliosPersonasResponse": {
                  "domicilioPersona.$": "$.Payload.listDomicilios.domicilio"
                }
              },
              "Catch": [
                {
                  "ErrorEquals": ["ValidationError", "BusinessRuleError", "DomainError"],
                  "ResultPath": "$.busError",
                  "Next": "ParseLambdaErrorAddresses"
                }
              ],
              "End": true
            },

            "ParseLambdaErrorAddresses": {
              "Type": "Pass",
              "Parameters": {
                "parsedError.$": "States.StringToJson($.busError.Cause)"
              },
              "Next": "HandleLambdaErrorAddresses"
            },

            "HandleLambdaErrorAddresses": {
              "Type": "Pass",
              "Parameters": {
                "domiciliosPersonasResponse": {
                  "message.$": "$.parsedError.errorMessage",
                  "error": {
                    "type.$": "$.parsedError.errorType",
                    "message.$": "$.parsedError.errorMessage",
                    "metadata.$": "$.parsedError.metadata"
                  }
                }
              },
              "End": true
            }
          }
        }
      ],
      "Next": "MergeParallelResults"
    },

    "DecideDomiciliosHttp": {
      "Type": "Choice",
      "Choices": [
        { "Variable": "$.request.consultarDomiciliosPersonas", "BooleanEquals": true, "Next": "ParallelHttpPersonaDomicilios" }
      ],
      "Default": "OnlyPersonHttp"
    },

    "ParallelHttpPersonaDomicilios": {
      "Type": "Parallel",
      "ResultPath": "$.parallel",
      "Branches": [
        {
          "StartAt": "HttpGetPhysicalPerson",
          "States": {
            "HttpGetPhysicalPerson": {
              "Type": "Task",
              "Resource": "arn:aws:states:::http:invoke",
              "Parameters": {
                "Method": "POST",
                "ApiEndpoint": "https://yv4bh5uymk.execute-api.us-east-1.amazonaws.com/dev/person/physical",
                "Authentication": {
                  "ConnectionArn": "arn:aws:events:us-east-1:334333507387:connection/bancow-apigw-connection/b8969188-f094-4069-a04b-6689bcbf6495"
                },
                "RequestBody.$": "$.request"
              },
              "ResultSelector": { "persona.$": "$.ResponseBody" },
              "End": true
            }
          }
        },
        {
          "StartAt": "HttpGetAddresses",
          "States": {
            "HttpGetAddresses": {
              "Type": "Task",
              "Resource": "arn:aws:states:::http:invoke",
              "Parameters": {
                "Method": "POST",
                "ApiEndpoint": "https://yv4bh5uymk.execute-api.us-east-1.amazonaws.com/dev/person/addresses",
                "Authentication": {
                  "ConnectionArn": "arn:aws:events:us-east-1:334333507387:connection/bancow-apigw-connection/b8969188-f094-4069-a04b-6689bcbf6495"
                },
                "RequestBody.$": "$.request"
              },
              "ResultSelector": {
                "domiciliosPersonasResponse.$": "$.ResponseBody"
              },
              "End": true
            }
          }
        }
      ],
      "Next": "MergeParallelResults"
    },

    "MergeParallelResults": {
      "Type": "Pass",
      "Parameters": {
        "personaFisicaResponse.$": "$.parallel[0].persona",
        "domiciliosPersonasResponse.$": "$.parallel[1].domiciliosPersonasResponse"
      },
      "Next": "HttpResponse"
    },

    "OnlyPerson": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "${GetPersonFn}",
        "Payload.$": "$.request"
      },
      "ResultSelector": {
        "personaFisicaResponse.$": "$.Payload"
      },
      "Next": "HttpResponse"
    },

    "OnlyPersonHttp": {
      "Type": "Task",
      "Resource": "arn:aws:states:::http:invoke",
      "Parameters": {
        "Method": "POST",
        "ApiEndpoint": "https://yv4bh5uymk.execute-api.us-east-1.amazonaws.com/dev/person/physical",
        "Authentication": {
          "ConnectionArn": "arn:aws:events:us-east-1:334333507387:connection/bancow-apigw-connection/b8969188-f094-4069-a04b-6689bcbf6495"
        },
        "RequestBody.$": "$.request"
      },
      "ResultSelector": {
        "personaFisicaResponse.$": "$.ResponseBody"
      },
      "Next": "HttpResponse"
    },

    "HttpResponse": {
      "Type": "Pass",
      "Parameters": {
        "personaFisicaResponse.$": "$.personaFisicaResponse",
        "domiciliosPersonasResponse.$": "$.domiciliosPersonasResponse"
      },
      "End": true
    },

    "ValidationFailed": {
      "Type": "Fail",
      "Error": "ValidationError",
      "Cause": "Missing required input fields"
    }
  }
}
