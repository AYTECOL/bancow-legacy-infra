{
  "Comment": "BANCOW - Natural Person Orchestration",
  "StartAt": "InitInput",
  "States": {
    "InitInput": {
      "Type": "Pass",
      "Parameters": { "request.$": "$" },
      "Next": "ValidateInput"
    },
    "ValidateInput": {
      "Type": "Choice",
      "Choices": [
        {
          "And": [
            { "Variable": "$.request.numeroIdentificacion", "IsPresent": true },
            { "Variable": "$.request.pais", "IsPresent": true },
            { "Variable": "$.request.tipoIdentificacion", "IsPresent": true },
            { "Variable": "$.request.consultarDomiciliosPersonas", "IsPresent": true }
          ],
          "Next": "InitContext"
        }
      ],
      "Default": "ValidationFailed"
    },
    "InitContext": {
      "Type": "Pass",
      "Parameters": {
        "request.$": "$.request",
        "defaultError": { "error": { "metadata": {} } },
        "domiciliosPersonasResponse": ""
      },
      "Next": "ValidateExecutionMode"
    },
    "ValidateExecutionMode": {
      "Type": "Choice",
      "Choices": [
        { "Variable": "$.request.executionMode", "StringEquals": "HTTP", "Next": "DecideDomiciliosHttp" }
      ],
      "Default": "DecideDomiciliosLambda"
    },

    "DecideDomiciliosLambda": {
      "Type": "Choice",
      "Choices": [
        { "Variable": "$.request.consultarDomiciliosPersonas", "BooleanEquals": true, "Next": "ParallelPersonaDomicilios" }
      ],
      "Default": "OnlyPerson"
    },

    "ParallelPersonaDomicilios": {
      "Type": "Parallel",
      "ResultPath": "$.parallel",
      "Branches": [
        {
          "StartAt": "GetPhysicalPerson",
          "States": {
            "GetPhysicalPerson": {
              "Type": "Task",
              "Resource": "arn:aws:states:::lambda:invoke",
              "Parameters": {
                "FunctionName": "${GetPersonFn}",
                "Payload.$": "$.request"
              },
              "ResultSelector": { "persona.$": "$.Payload" },
              "Catch": [
                {
                  "ErrorEquals": ["ValidationError", "BusinessRuleError", "DomainError"],
                  "ResultPath": "$.busError",
                  "Next": "MapLambdaErrorPersona"
                }
              ],
              "End": true
            },
            "MapLambdaErrorPersona": {
              "Type": "Pass",
              "Parameters": {
                "domiciliosPersonasResponse.$": "$.domiciliosPersonasResponse",
                "request.$": "$.request",
                "defaultError.$": "$.defaultError",
                "busError.$": "$.busError",
                "parsedError": {
                  "errorType.$": "$.busError.Error",
                  "errorMessage.$": "$.busError.Cause",
                  "metadata.$": "$.busError"
                }
              },
              "Next": "BuildPersonaError"
            },

            "BuildPersonaError": {
              "Type": "Pass",
              "Parameters": {
                "persona": {
                  "message.$": "$.parsedError.errorMessage",
                  "error": {
                    "type.$": "$.parsedError.errorType",
                    "message.$": "$.parsedError.errorMessage",
                    "metadata.$": "$.parsedError.metadata"
                  }
                }
              },
              "End": true
            }
          }
        },
        {
          "StartAt": "GetAddresses",
          "States": {
            "GetAddresses": {
              "Type": "Task",
              "Resource": "arn:aws:states:::lambda:invoke",
              "Parameters": {
                "FunctionName": "${GetAddressesFn}",
                "Payload.$": "$.request"
              },
              "ResultSelector": {
                "domiciliosPersonasResponse": {
                  "domicilioPersona.$": "$.Payload.listDomicilios.domicilio"
                }
              },
              "Catch": [
                {
                  "ErrorEquals": ["ValidationError", "BusinessRuleError", "DomainError"],
                  "ResultPath": "$.busError",
                  "Next": "MapLambdaErrorAddresses"
                }
              ],
              "End": true
            },
            "MapLambdaErrorAddresses": {
              "Type": "Pass",
              "Parameters": {
                "domiciliosPersonasResponse.$": "$.domiciliosPersonasResponse",
                "request.$": "$.request",
                "defaultError.$": "$.defaultError",
                "busError.$": "$.busError",
                "parsedError": {
                  "errorType.$": "$.busError.Error",
                  "errorMessage.$": "$.busError.Cause",
                  "metadata.$": "$.busError"
                }
              },
              "Next": "BuildAddressesError"
            },


            "BuildAddressesError": {
              "Type": "Pass",
              "Parameters": {
                "domiciliosPersonasResponse": {
                  "message.$": "$.parsedError.errorMessage",
                  "error": {
                    "type.$": "$.parsedError.errorType",
                    "message.$": "$.parsedError.errorMessage",
                    "metadata.$": "$.parsedError.metadata"
                  }
                }
              },
              "End": true
            }
          }
        }
      ],
      "Next": "MergeParallelResults"
    },

    "OnlyPerson": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "${GetPersonFn}",
        "Payload.$": "$.request"
      },
      "ResultPath": "$.personaFisicaResponse",
      "ResultSelector": {
        "personaFisicaResponse.$": "$.Payload"
      },
      "Catch": [
        {
          "ErrorEquals": ["ValidationError", "BusinessRuleError", "DomainError"],
          "ResultPath": "$.busError",
          "Next": "MapLambdaErrorOnlyPerson"
        }
      ],
      "Next": "HttpResponse"
    },
    "MapLambdaErrorOnlyPerson": {
      "Type": "Pass",
      "Parameters": {
        "personaFisicaResponse": {
          "message.$": "$.busError.Cause",
          "error": {
            "type.$": "$.busError.Error",
            "message.$": "$.busError.Cause",
            "metadata.$": "$.busError"
          }
        },
        "domiciliosPersonasResponse": ""
      },
      "Next": "HttpResponse"
    },
    "DecideDomiciliosHttp": {
      "Type": "Choice",
      "Choices": [
        { "Variable": "$.request.consultarDomiciliosPersonas", "BooleanEquals": true, "Next": "ParallelHttpPersonaDomicilios" }
      ],
      "Default": "OnlyPersonHttp"
    },

    "ParallelHttpPersonaDomicilios": {
      "Type": "Parallel",
      "ResultPath": "$.parallel",
      "Branches": [
        {
          "StartAt": "HttpGetPhysicalPerson",
          "States": {
            "HttpGetPhysicalPerson": {
              "Type": "Task",
              "Resource": "arn:aws:states:::http:invoke",
              "Parameters": {
                "Method": "POST",
                "ApiEndpoint": "https://yv4bh5uymk.execute-api.us-east-1.amazonaws.com/dev/person/physical",
                "Authentication": {
                  "ConnectionArn": "arn:aws:events:us-east-1:334333507387:connection/bancow-apigw-connection/b8969188-f094-4069-a04b-6689bcbf6495"
                },
                "RequestBody.$": "$.request"
              },
              "ResultSelector": { "persona.$": "$.ResponseBody" },
              "Catch": [
                {
                  "ErrorEquals": ["States.ALL"],
                  "ResultPath": "$.busError",
                  "Next": "MapHttpErrorPersona"
                }
              ],
              "End": true
            },
            "MapHttpErrorPersona": {
              "Type": "Pass",
              "Parameters": {
                "domiciliosPersonasResponse.$": "$.domiciliosPersonasResponse",
                "request.$": "$.request",
                "defaultError.$": "$.defaultError",
                "busError.$": "$.busError",
                "parsedError": {
                  "message.$": "$.busError.Cause",
                  "error": {
                    "type.$": "$.busError.Error",
                    "message.$": "$.busError.Cause",
                    "metadata": {}
                  }
                }
              },
              "Next": "BuildHttpPersonaError"
            },
            "BuildHttpPersonaError": {
              "Type": "Pass",
              "Parameters": {
                "persona": {
                  "message.$": "$.parsedError.message",
                  "error": {
                    "type.$": "$.parsedError.error.type",
                    "message.$": "$.parsedError.error.message",
                    "metadata.$": "$.parsedError.error.metadata"
                  }
                }
              },
              "End": true
            }
          }
        },
        {
          "StartAt": "HttpGetAddresses",
          "States": {
            "HttpGetAddresses": {
              "Type": "Task",
              "Resource": "arn:aws:states:::http:invoke",
              "Parameters": {
                "Method": "POST",
                "ApiEndpoint": "https://yv4bh5uymk.execute-api.us-east-1.amazonaws.com/dev/person/addresses",
                "Authentication": {
                  "ConnectionArn": "arn:aws:events:us-east-1:334333507387:connection/bancow-apigw-connection/b8969188-f094-4069-a04b-6689bcbf6495"
                },
                "RequestBody.$": "$.request"
              },
              "ResultSelector": {
                "domiciliosPersonasResponse": {
                  "domicilioPersona.$": "$.ResponseBody.listDomicilios.domicilio"
                }
              },

              "Catch": [
                {
                  "ErrorEquals": ["States.ALL"],
                  "ResultPath": "$.busError",
                  "Next": "MapHttpErrorAddresses"
                }
              ],
              "End": true
            },
            "MapHttpErrorAddresses": {
              "Type": "Pass",
              "Parameters": {
                "domiciliosPersonasResponse.$": "$.domiciliosPersonasResponse",
                "request.$": "$.request",
                "defaultError.$": "$.defaultError",
                "busError.$": "$.busError",
                "parsedError": {
                  "message.$": "$.busError.Cause",
                  "error": {
                    "type.$": "$.busError.Error",
                    "message.$": "$.busError.Cause",
                    "metadata": {}
                  }
                }
              },
              "Next": "BuildHttpAddressesError"
            },
            "BuildHttpAddressesError": {
              "Type": "Pass",
              "Parameters": {
                "domiciliosPersonasResponse": {
                  "message.$": "$.parsedError.message",
                  "error": {
                    "type.$": "$.parsedError.error.type",
                    "message.$": "$.parsedError.error.message",
                    "metadata.$": "$.parsedError.error.metadata"
                  }
                }
              },
              "End": true
            }
          }
        }
      ],
      "Next": "MergeParallelResults"
    },

    "MergeParallelResults": {
      "Type": "Pass",
      "Parameters": {
        "personaFisicaResponse.$": "$.parallel[0].persona",
        "domiciliosPersonasResponse.$": "$.parallel[1].domiciliosPersonasResponse"
      },
      "Next": "HttpResponse"
    },

    "OnlyPersonHttp": {
      "Type": "Task",
      "Resource": "arn:aws:states:::http:invoke",
      "Parameters": {
        "Method": "POST",
        "ApiEndpoint": "https://yv4bh5uymk.execute-api.us-east-1.amazonaws.com/dev/person/physical",
        "Authentication": {
          "ConnectionArn": "arn:aws:events:us-east-1:334333507387:connection/bancow-apigw-connection/b8969188-f094-4069-a04b-6689bcbf6495"
        },
        "RequestBody.$": "$.request"
      },
      "ResultPath": "$.personaFisicaResponse",
      "ResultSelector": {
        "personaFisicaResponse.$": "$.ResponseBody"
      },
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "ResultPath": "$.busError",
          "Next": "MapHttpErrorOnlyPerson"
        }
      ],
      "Next": "HttpResponse"
    },

    "MapHttpErrorOnlyPerson": {
      "Type": "Pass",
      "Parameters": {
        "domiciliosPersonasResponse.$": "$.domiciliosPersonasResponse",
        "request.$": "$.request",
        "defaultError.$": "$.defaultError",
        "busError.$": "$.busError",
        "parsedError": {
          "message.$": "$.busError.Cause",
          "error": {
            "type.$": "$.busError.Error",
            "message.$": "$.busError.Cause",
            "metadata": {}
          }
        }
      },
      "Next": "BuildHttpOnlyPersonError"
    },

    "BuildHttpOnlyPersonError": {
      "Type": "Pass",
      "Parameters": {
        "personaFisicaResponse": {
          "message.$": "$.parsedError.message",
          "error": {
            "type.$": "$.parsedError.error.type",
            "message.$": "$.parsedError.error.message",
            "metadata.$": "$.parsedError.error.metadata"
          }
        },
        "domiciliosPersonasResponse.$": "$.domiciliosPersonasResponse"
      },
      "Next": "HttpResponse"
    },

    "HttpResponse": {
      "Type": "Pass",
      "Parameters": {
        "personaFisicaResponse.$": "$.personaFisicaResponse",
        "domiciliosPersonasResponse.$": "$.domiciliosPersonasResponse"
      },
      "End": true
    },

    "ValidationFailed": {
      "Type": "Fail",
      "Error": "ValidationError",
      "Cause": "Missing required input fields"
    }
  }
}
