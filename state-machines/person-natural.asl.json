{
  "Comment": "BANCOW - Natural Person Orchestration",
  "StartAt": "Init",
  "States": {
    "Init": {
      "Type": "Pass",
      "Parameters": {
        "request.$": "$"
      },
      "Next": "ValidateMinimalInput"
    },

    "ValidateMinimalInput": {
      "Type": "Choice",
      "Choices": [
        {
          "Variable": "$.request.numeroIdentificacion",
          "IsPresent": true,
          "Next": "ValidatePais"
        }
      ],
      "Default": "ValidationFailed"
    },

    "ValidatePais": {
      "Type": "Choice",
      "Choices": [
        {
          "Variable": "$.request.pais",
          "IsPresent": true,
          "Next": "ValidateTipoIdentificacion"
        }
      ],
      "Default": "ValidationFailed"
    },

    "ValidateTipoIdentificacion": {
      "Type": "Choice",
      "Choices": [
        {
          "Variable": "$.request.tipoIdentificacion",
          "IsPresent": true,
          "Next": "ValidateConsultarDomicilios"
        }
      ],
      "Default": "ValidationFailed"
    },

    "ValidateConsultarDomicilios": {
      "Type": "Choice",
      "Choices": [
        {
          "Variable": "$.request.consultarDomiciliosPersonas",
          "IsPresent": true,
          "Next": "DecideDomicilios"
        }
      ],
      "Default": "ValidationFailed"
    },

    "DecideDomicilios": {
      "Type": "Choice",
      "Choices": [
        {
          "Variable": "$.request.consultarDomiciliosPersonas",
          "BooleanEquals": true,
          "Next": "ParallelPersonaDomicilios"
        }
      ],
      "Default": "OnlyPerson"
    },

    "ParallelPersonaDomicilios": {
      "Type": "Parallel",
      "ResultPath": "$.parallel",
      "Branches": [
        {
          "StartAt": "GetPhysicalPerson",
          "States": {
            "GetPhysicalPerson": {
              "Type": "Task",
              "Resource": "arn:aws:states:::lambda:invoke",
              "Parameters": {
                "FunctionName": "${GetPersonFn}",
                "Payload.$": "$.request"
              },
              "ResultSelector": {
                "personaRaw.$": "$.Payload"
              },
              "Retry": [
                {
                  "ErrorEquals": ["States.TaskFailed"],
                  "IntervalSeconds": 2,
                  "MaxAttempts": 3,
                  "BackoffRate": 2
                }
              ],
              "Catch": [
                {
                  "ErrorEquals": ["States.ALL"],
                  "Next": "PhysicalPersonFailed"
                }
              ],
              "Next": "NormalizePerson"
            },
            "NormalizePerson": {
              "Type": "Choice",
              "Choices": [
                {
                  "Variable": "$.personaRaw",
                  "IsString": true,
                  "Next": "ParsePersonJson"
                }
              ],
              "Default": "PersonAsObject"
            },
            "ParsePersonJson": {
              "Type": "Pass",
              "Parameters": {
                "personaObj.$": "States.StringToJson($.personaRaw)"
              },
              "Next": "ShapePerson"
            },
            "PersonAsObject": {
              "Type": "Pass",
              "Parameters": {
                "personaObj.$": "$.personaRaw"
              },
              "Next": "ShapePerson"
            },
            "ShapePerson": {
              "Type": "Choice",
              "Choices": [
                {
                  "Variable": "$.personaObj.personaFisicaResponse",
                  "IsPresent": true,
                  "Next": "PersonFromWrapper"
                }
              ],
              "Default": "PersonDirect"
            },
            "PersonFromWrapper": {
              "Type": "Pass",
              "Parameters": {
                "persona.$": "$.personaObj.personaFisicaResponse"
              },
              "End": true
            },
            "PersonDirect": {
              "Type": "Pass",
              "Parameters": {
                "persona.$": "$.personaObj"
              },
              "End": true
            },
            "PhysicalPersonFailed": {
              "Type": "Fail",
              "Error": "PhysicalPersonError",
              "Cause": "Failed to retrieve physical person data"
            }
          }
        },
        {
          "StartAt": "GetAddresses",
          "States": {
            "GetAddresses": {
              "Type": "Task",
              "Resource": "arn:aws:states:::lambda:invoke",
              "Parameters": {
                "FunctionName": "${GetAddressesFn}",
                "Payload.$": "$.request"
              },
              "ResultSelector": {
                "domiciliosRaw.$": "$.Payload"
              },
              "Retry": [
                {
                  "ErrorEquals": ["States.TaskFailed"],
                  "IntervalSeconds": 2,
                  "MaxAttempts": 3,
                  "BackoffRate": 2
                }
              ],
              "Catch": [
                {
                  "ErrorEquals": ["States.ALL"],
                  "Next": "AddressesFailed"
                }
              ],
              "Next": "NormalizeAddresses"
            },
            "NormalizeAddresses": {
              "Type": "Choice",
              "Choices": [
                {
                  "Variable": "$.domiciliosRaw",
                  "IsString": true,
                  "Next": "ParseAddressesJson"
                }
              ],
              "Default": "AddressesAsObject"
            },
            "ParseAddressesJson": {
              "Type": "Pass",
              "Parameters": {
                "domiciliosObj.$": "States.StringToJson($.domiciliosRaw)"
              },
              "Next": "ShapeAddresses"
            },
            "AddressesAsObject": {
              "Type": "Pass",
              "Parameters": {
                "domiciliosObj.$": "$.domiciliosRaw"
              },
              "Next": "ShapeAddresses"
            },
            "ShapeAddresses": {
              "Type": "Choice",
              "Choices": [
                {
                  "Variable": "$.domiciliosObj.domiciliosPersonasResponse.domicilioPersona",
                  "IsPresent": true,
                  "Next": "AddressesFromWrapper"
                },
                {
                  "Variable": "$.domiciliosObj.listDomicilios.domicilio",
                  "IsPresent": true,
                  "Next": "AddressesFromListDomicilios"
                },
                {
                  "Variable": "$.domiciliosObj.domicilioPersona",
                  "IsPresent": true,
                  "Next": "AddressesFromDomicilioPersona"
                }
              ],
              "Default": "AddressesEmpty"
            },
            "AddressesFromWrapper": {
              "Type": "Pass",
              "Parameters": {
                "domicilioPersona.$": "$.domiciliosObj.domiciliosPersonasResponse.domicilioPersona"
              },
              "Next": "WrapAddresses"
            },
            "AddressesFromListDomicilios": {
              "Type": "Pass",
              "Parameters": {
                "domicilioPersona.$": "$.domiciliosObj.listDomicilios.domicilio"
              },
              "Next": "WrapAddresses"
            },
            "AddressesFromDomicilioPersona": {
              "Type": "Pass",
              "Parameters": {
                "domicilioPersona.$": "$.domiciliosObj.domicilioPersona"
              },
              "Next": "WrapAddresses"
            },
            "AddressesEmpty": {
              "Type": "Pass",
              "Parameters": {
                "domicilioPersona": []
              },
              "Next": "WrapAddresses"
            },
            "WrapAddresses": {
              "Type": "Pass",
              "Parameters": {
                "domiciliosPersonasResponse": {
                  "domicilioPersona.$": "$.domicilioPersona"
                }
              },
              "End": true
            },
            "AddressesFailed": {
              "Type": "Fail",
              "Error": "AddressesError",
              "Cause": "Failed to retrieve addresses data"
            }
          }
        }
      ],
      "Next": "MergeParallelResults"
    },

    "MergeParallelResults": {
      "Type": "Pass",
      "Parameters": {
        "domiciliosPersonasResponse.$": "$.parallel[1].domiciliosPersonasResponse",
        "personaFisicaResponse.$": "$.parallel[0].persona"
      },
      "Next": "Success"
    },

    "OnlyPerson": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "${GetPersonFn}",
        "Payload.$": "$.request"
      },
      "ResultSelector": {
        "personaRaw.$": "$.Payload"
      },
      "ResultPath": "$.result",
      "Retry": [
        {
          "ErrorEquals": ["States.TaskFailed"],
          "IntervalSeconds": 2,
          "MaxAttempts": 3,
          "BackoffRate": 2
        }
      ],
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "Next": "ProcessingFailed"
        }
      ],
      "Next": "NormalizePersonSingle"
    },

    "NormalizePersonSingle": {
      "Type": "Choice",
      "Choices": [
        {
          "Variable": "$.result.personaRaw",
          "IsString": true,
          "Next": "ParsePersonJsonSingle"
        }
      ],
      "Default": "PersonAsObjectSingle"
    },

    "ParsePersonJsonSingle": {
      "Type": "Pass",
      "Parameters": {
        "personaObj.$": "States.StringToJson($.result.personaRaw)"
      },
      "ResultPath": "$.result",
      "Next": "ShapePersonSingle"
    },

    "PersonAsObjectSingle": {
      "Type": "Pass",
      "Parameters": {
        "personaObj.$": "$.result.personaRaw"
      },
      "ResultPath": "$.result",
      "Next": "ShapePersonSingle"
    },

    "ShapePersonSingle": {
      "Type": "Choice",
      "Choices": [
        {
          "Variable": "$.result.personaObj.personaFisicaResponse",
          "IsPresent": true,
          "Next": "PersonFromWrapperSingle"
        }
      ],
      "Default": "PersonDirectSingle"
    },

    "PersonFromWrapperSingle": {
      "Type": "Pass",
      "Parameters": {
        "persona.$": "$.result.personaObj.personaFisicaResponse"
      },
      "ResultPath": "$.result",
      "Next": "PrepareSingleResult"
    },

    "PersonDirectSingle": {
      "Type": "Pass",
      "Parameters": {
        "persona.$": "$.result.personaObj"
      },
      "ResultPath": "$.result",
      "Next": "PrepareSingleResult"
    },

    "PrepareSingleResult": {
      "Type": "Pass",
      "Parameters": {
        "domiciliosPersonasResponse": {
          "domicilioPersona": []
        },
        "personaFisicaResponse.$": "$.result.persona"
      },
      "Next": "Success"
    },

    "ValidationFailed": {
      "Type": "Fail",
      "Error": "ValidationError",
      "Cause": "Missing required input fields"
    },

    "ProcessingFailed": {
      "Type": "Fail",
      "Error": "ProcessingError",
      "Cause": "Unexpected error during processing"
    },

    "Success": {
      "Type": "Succeed"
    }
  }
}
