{
  "Comment": "Express Async - Rick and Morty API Integration",
  "StartAt": "InvokeRickApi",
  "States": {
    "InvokeRickApi": {
      "Type": "Task",
      "Resource": "arn:aws:states:::http:invoke",
      "Parameters": {
        "Method": "GET",
        "ApiEndpoint.$": "States.Format('https://rickandmortyapi.com/api/character/{}', $.characterId)",
        "Authentication": {
          "ConnectionArn": "arn:aws:events:us-east-1:334333507387:connection/RickMortyPublic/e3b89041-f408-4cb4-84ff-79221e1dbb71"
        }
      },
      "Retry": [
        {
          "ErrorEquals": [
            "States.Timeout",
            "States.TaskFailed"
          ],
          "IntervalSeconds": 2,
          "MaxAttempts": 2,
          "BackoffRate": 1.5
        }
      ],
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "ResultPath": "$.errorInfo",
          "Next": "SaveError"
        }
      ],
      "ResultPath": "$.apiResponse",
      "Next": "TransformSuccess"
    },
    "TransformSuccess": {
      "Type": "Pass",
      "Parameters": {
        "requestId.$": "$$.Execution.Id",
        "status": "COMPLETED",
        "characterId.$": "$.characterId",
        "response": {
          "statusCode.$": "$.apiResponse.StatusCode",
          "body.$": "$.apiResponse.ResponseBody"
        },
        "timestamp.$": "$$.State.EnteredTime"
      },
      "Next": "SaveSuccess"
    },
    "SaveSuccess": {
      "Type": "Task",
      "Resource": "arn:aws:states:::aws-sdk:dynamodb:putItem",
      "Parameters": {
        "TableName": "bancow-dev-async-results",
        "Item": {
          "requestId": {
            "S.$": "$.requestId"
          },
          "status": {
            "S": "COMPLETED"
          },
          "characterId": {
            "N.$": "States.Format('{}', $.characterId)"
          },
          "statusCode": {
            "N.$": "States.Format('{}', $.response.statusCode)"
          },
          "characterData": {
            "S.$": "States.JsonToString($.response.body)"
          },
          "timestamp": {
            "S.$": "$.timestamp"
          },
          "ttl": {
            "N": "1769531400"
          }
        }
      },
      "End": true
    },
    "SaveError": {
      "Type": "Task",
      "Resource": "arn:aws:states:::aws-sdk:dynamodb:putItem",
      "Parameters": {
        "TableName": "bancow-dev-async-results",
        "Item": {
          "requestId": {
            "S.$": "$.requestId"
          },
          "status": {
            "S": "FAILED"
          },
          "characterId": {
            "N.$": "States.Format('{}', $.characterId)"
          },
          "error": {
            "S.$": "States.JsonToString($.errorInfo)"
          },
          "timestamp": {
            "S.$": "$$.State.EnteredTime"
          },
          "ttl": {
            "N": "1769531400"
          }
        }
      },
      "Retry": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "IntervalSeconds": 1,
          "MaxAttempts": 2,
          "BackoffRate": 2
        }
      ],
      "End": true
    }
  }
}